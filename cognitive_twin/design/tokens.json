{
  "$meta": {
    "name": "Vera design tokens",
    "description": "The single source of truth for Vera's visual system across every surface (web dashboard, iOS, Windows, Linux) and the BuildingLink booker dashboard. Tailscale-quality: one green accent, flat near-shadowless cards, system/Inter font, light + dark. Every renderer reads THESE values \u2014 never hand-copies a hex. Regenerate tokens.css from here with design/build_tokens.py.",
    "reference": "Tailscale macOS/iOS app",
    "owner": "sinhaankur"
  },
  "font": {
    "family": "-apple-system, \"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "size": "15px",
    "lineHeight": "1.5",
    "smoothing": "antialiased"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "pill": "999px"
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "14px",
    "lg": "20px",
    "xl": "34px"
  },
  "toggle": {
    "width": "42px",
    "height": "25px",
    "knob": "19px",
    "travel": "17px"
  },
  "color": {
    "accent": {
      "light": "#bf8a3c",
      "dark": "#d6a95f"
    },
    "accentInk": {
      "light": "#8a6420",
      "dark": "#e4bd7e"
    },
    "accentSoft": {
      "light": "#f4ecdd",
      "dark": "#261f12"
    },
    "bg": {
      "light": "#f6f6f5",
      "dark": "#17171a"
    },
    "panel": {
      "light": "#ffffff",
      "dark": "#1f1f23"
    },
    "ink": {
      "light": "#1a1a19",
      "dark": "#ededed"
    },
    "muted": {
      "light": "#6b6b66",
      "dark": "#9b9b9b"
    },
    "line": {
      "light": "#ececea",
      "dark": "#2c2c31"
    },
    "warn": {
      "light": "#b06a00",
      "dark": "#e0a44a"
    },
    "warnSoft": {
      "light": "#fdf3e3",
      "dark": "#2e2615"
    },
    "danger": {
      "light": "#c0392b",
      "dark": "#e06a5e"
    },
    "dangerSoft": {
      "light": "#fbeceb",
      "dark": "#2e1a18"
    }
  },
  "shadow": {
    "card": {
      "light": "0 1px 2px rgba(0,0,0,.04)",
      "dark": "0 1px 2px rgba(0,0,0,.3)"
    },
    "pop": {
      "light": "0 12px 44px rgba(0,0,0,.2)",
      "dark": "0 12px 44px rgba(0,0,0,.28)"
    }
  }
}