# OpenAI-compatible local server settings
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model

# Orchestrator settings
AGENT_WORKSPACE_ROOT=.
AGENT_SYSTEM_DNA=system_dna.md
AGENT_MAX_TOOL_STEPS=4

# Multimodal defaults (optional)
AGENT_ENABLE_CAMERA=false
AGENT_ENABLE_AUDIO=false
AGENT_MULTIMODAL_INTERVAL=3
AGENT_MULTIMODAL_ITERATIONS=1
AGENT_ENABLE_TRANSCRIPTION=true
AGENT_TRANSCRIPTION_MODEL=base
AGENT_TRANSCRIPTION_COMPUTE_TYPE=int8
AGENT_TRANSCRIPTION_DEVICE=auto

# Secure daemon auth
AGENT_DAEMON_TOKEN=

# Email (read-only IMAP; talks to your provider directly, nothing uploaded).
# Full setup guide: docs/EMAIL-SETUP.md
# NOTE: put your address here, but DON'T put the password here — store it in the
# macOS Keychain instead:  python3 -m cognitive_twin.secrets_store set IMAP_PASSWORD
# (Use a Gmail *app password*, not your main login.) IMAP_PASSWORD here is only a
# legacy fallback; the Keychain is preferred and what `security doctor` expects.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# IMAP_PASSWORD=        # prefer: secrets_store set IMAP_PASSWORD (Keychain)
IMAP_FOLDER=INBOX

# Connector credentials. For Gmail OAuth (optional, Path B in docs/EMAIL-SETUP.md),
# store the client id/secret in the Keychain too:
#   python3 -m cognitive_twin.secrets_store set GOOGLE_OAUTH_CLIENT_ID
#   python3 -m cognitive_twin.secrets_store set GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=
# GOOGLE_OAUTH_CLIENT_ID / _SECRET → Keychain (see above); env is legacy fallback
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
NOTION_API_TOKEN=
NOTION_DATABASE_ID=
TODOIST_API_TOKEN=
